# Required: base64-encoded key for signing JWTs, e.g. `openssl rand -base64 32`
JWT_KEY=

# true = fake USOS with generated timetables (no keys needed); false = real USOS PW
USOS_MOCK=true
# USOS API consumer key/secret (https://apps.usos.pw.edu.pl/developers/), only needed with USOS_MOCK=false
CONSUMER_KEY=
CONSUMER_SECRET=

# Address the app is reachable at (used for the USOS OAuth callback and CORS)
PUBLIC_URL=http://localhost:8091
POSTGRES_USER=tradeiti
POSTGRES_PASSWORD=tradeiti
